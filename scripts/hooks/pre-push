#!/usr/bin/env bash
# Pre-push hook: runs the privacy lint (generic checks plus the private pattern
# list) on every commit that this push sends. Install with
#   git config core.hooksPath scripts/hooks
# See CONTRIBUTING.md.
set -euo pipefail

remote="$1"
list="${AGENTIC_DEV_WORKFLOW_PATTERNS:-$HOME/.config/agentic-dev-workflow/private-patterns}"
lint="$(git rev-parse --show-toplevel)/scripts/privacy-lint.sh"
zero="0000000000000000000000000000000000000000"

if [ ! -r "$list" ]; then
  echo "pre-push: private pattern list not found at the configured path." >&2
  echo "pre-push: create it (see CONTRIBUTING.md) or set AGENTIC_DEV_WORKFLOW_PATTERNS." >&2
  exit 1
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # branch deletion
  # New branch, or a remote tip we do not have locally (remote ahead, not fetched):
  # check everything not yet on any ref of this remote.
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$local_sha --not --remotes=$remote"
  else
    range="$remote_sha..$local_sha"
  fi
  echo "pre-push: checking $local_ref -> $remote_ref"
  "$lint" --range "$range" --private "$list" || status=1
done

if [ "$status" != 0 ]; then
  echo "pre-push: push blocked by the privacy lint." >&2
fi
exit "$status"
